<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgSecondary"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manual_connection_shortcut"
        android:textColor="@color/colorPrimaryDark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="8dp">

        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shortcut_background"
            android:id="@+id/check_background"
            android:textColor="@color/textPrimary"
            android:layout_margin="4dp"
            android:onClick="check_background" />

        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shortcut_force"
            android:id="@+id/check_force"
            android:textColor="@color/textPrimary"
            android:layout_margin="4dp"
            android:enabled="false" />

        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_log"
            android:id="@+id/check_log"
            android:textColor="@color/textPrimary"
            android:layout_margin="4dp"
            android:onClick="check_log" />

        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:id="@+id/check_stop"
            android:textColor="@color/textPrimary"
            android:layout_margin="4dp"
            android:onClick="check_stop" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:text="@string/cancel"
            android:onClick="button_cancel"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/colorPrimaryDark"
            android:textAllCaps="false" />

        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="@string/save"
            android:onClick="button_save"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/textOnPrimary"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
