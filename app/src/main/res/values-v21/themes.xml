<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="@android:style/Theme.DeviceDefault.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bgSecondary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:actionBarStyle">@style/ActionBarGreen</item>
        <item name="android:buttonStyle">@style/WifiMetroButton</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:windowActionBarOverlay">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="ActionBarGreen" parent="@android:style/Widget.DeviceDefault.Light.ActionBar.Solid">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:titleTextStyle">@style/ActionBarGreenTitle</item>
    </style>

    <style name="ActionBarGreenTitle" parent="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textColor">@color/textOnPrimary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AppBaseThemeDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bgPrimary</item>
    </style>

    <!-- Keep old name as alias for Manifest -->
    <style name="AppBaseTheme.Dialog" parent="@style/AppBaseThemeDialog" />

    <style name="AppBaseTheme.Dark" parent="@android:style/Theme.DeviceDefault">
        <item name="android:colorPrimary">@color/colorPrimaryDarkTheme</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDarkDarkTheme</item>
        <item name="android:colorAccent">@color/colorAccentDarkTheme</item>
        <item name="android:windowBackground">@color/bgSecondaryDarkTheme</item>
        <item name="android:statusBarColor">@color/colorPrimaryDarkDarkTheme</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDarkDarkTheme</item>
        <item name="android:actionBarStyle">@style/ActionBarDark</item>
        <item name="android:buttonStyle">@style/WifiMetroButton</item>
        <item name="android:textColorPrimary">@color/textPrimaryDarkTheme</item>
        <item name="android:textColorSecondary">@color/textSecondaryDarkTheme</item>
        <item name="android:windowActionBarOverlay">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="ActionBarDark" parent="@android:style/Widget.DeviceDefault.ActionBar.Solid">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:titleTextStyle">@style/ActionBarGreenTitle</item>
    </style>

    <style name="AppBaseThemeDarkDialog" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorAccent">@color/colorAccentDarkTheme</item>
        <item name="android:windowBackground">@color/bgSurfaceDarkTheme</item>
        <item name="android:textColorPrimary">@color/textPrimaryDarkTheme</item>
    </style>
    <style name="AppBaseTheme.Dark.Dialog" parent="@style/AppBaseThemeDarkDialog" />

    <style name="WifiMetroButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/textOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="WifiMetroButtonSecondary" parent="@style/WifiMetroButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
    </style>
</resources>
