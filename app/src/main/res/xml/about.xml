<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:title="@string/app_name"
        android:summary="@string/app_signature"
        android:icon="@drawable/ic_launcher"
        android:selectable="false" />

    <Preference
        android:title="@string/build_author_label"
        android:summary="@string/build_author_info"
        android:selectable="false" />

    <Preference
        android:title="@string/developer"
        android:summary="@string/developer_info"
        android:selectable="false" />

    <Preference
        android:title="@string/about_source"
        android:summary="@string/about_source_summary">
        <intent android:action="pw.thedrhax.mosmetro.activities.SafeViewActivity"
                android:targetPackage="pw.thedrhax.mosmetro"
                android:targetClass="pw.thedrhax.mosmetro.activities.SafeViewActivity">
            <extra android:name="data" android:value="@string/about_source_link" />
        </intent>
    </Preference>
</PreferenceScreen>
