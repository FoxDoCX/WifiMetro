<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15: opt out of forced edge-to-edge (ignored on 16+, SystemBarUtils pads instead) -->
    <style name="AppBaseTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bgSecondary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="actionBarStyle">@style/ActionBarGreen</item>
        <item name="android:buttonStyle">@style/WifiMetroButton</item>
        <item name="buttonStyle">@style/WifiMetroButton</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="preferenceTheme">@style/WifiMetroPreferenceTheme</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppBaseTheme.Dark" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/colorPrimaryDarkTheme</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkDarkTheme</item>
        <item name="colorAccent">@color/colorAccentDarkTheme</item>
        <item name="android:windowBackground">@color/bgSecondaryDarkTheme</item>
        <item name="android:statusBarColor">@color/colorPrimaryDarkDarkTheme</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDarkDarkTheme</item>
        <item name="actionBarStyle">@style/ActionBarDark</item>
        <item name="android:buttonStyle">@style/WifiMetroButton</item>
        <item name="buttonStyle">@style/WifiMetroButton</item>
        <item name="android:textColorPrimary">@color/textPrimaryDarkTheme</item>
        <item name="android:textColorSecondary">@color/textSecondaryDarkTheme</item>
        <item name="preferenceTheme">@style/WifiMetroPreferenceTheme</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
